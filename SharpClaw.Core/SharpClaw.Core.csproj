<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>0.5.0-beta.24</Version>
    <InformationalVersion>0.5.0-beta.24</InformationalVersion>
    <PackageId>SharpClaw.Core</PackageId>
    <Authors>mkn8rn</Authors>
    <Description>Host-agnostic SharpClaw direct-chat kernel with action, event, provider, and tool dispatch.</Description>
    <PackageTags>sharpclaw;core;kernel;chat;provider;tools;modules</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/SharpClaw-NET/SharpClaw.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SharpClaw-NET/SharpClaw.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NoWarn>1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Kernel\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageReference Include="SharpClaw.Contracts" Version="[0.5.0-beta.31]" />
  </ItemGroup>
</Project>
